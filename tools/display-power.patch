+  if (frequency < entry.minimumFreq || frequency > entry.maximumFreq ||
+      step > maxStep || width > maxWidth) return false;
+  entry.currentFreq = frequency;
+  entry.currentStepIdx = step;
+  entry.bandwidthIdx = width;
+  return true;
